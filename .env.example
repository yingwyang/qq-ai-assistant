# 数据库
DB_URL=jdbc:mysql://localhost:3306/qq_chat?useSSL=false&serverTimezone=Asia/Shanghai&characterEncoding=UTF-8&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_password_here

# 服务端口
SERVER_PORT=8081

# JPA
JPA_SHOW_SQL=false

# JWT
JWT_SECRET=your-256-bit-secret-key-for-jwt-signing-qq-ai-assistant
JWT_EXPIRATION=86400000

# AstrBot
ASTRBOT_API_URL=http://localhost:6185
ASTRBOT_TOKEN=your_astrbot_token
ASTRBOT_DATA_PATH=./Astrbot/data

# NapCat
NAPCAT_API_URL=http://localhost:6099
NAPCAT_TOKEN=your_napcat_token
NAPCAT_WEBHOOK_TOKEN=your_webhook_token
NAPCAT_SELF_QQ=your_qq_number

# GPT-SoVITS
GPT_SOVITS_API_URL=http://localhost:7860
GPT_SOVITS_TOKEN=your_gpt_sovits_token

# MinIO
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=your_minio_password
MINIO_BUCKET=qq-chat-files

# FFmpeg
FFMPEG_PATH=ffmpeg
