# =====================================================================
# QQ AI 助手 - 环境变量配置模板
# 复制此文件为 .env 并填入真实值
# 标注"必须配置"的变量启动前必须设置，否则应用将拒绝启动
# =====================================================================

# 数据库
DB_URL=jdbc:mysql://localhost:3306/qq_chat?useSSL=false&serverTimezone=Asia/Shanghai&characterEncoding=UTF-8&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_password_here                         # 必须配置

# 服务端口
SERVER_PORT=8081

# JPA
JPA_SHOW_SQL=false

# JWT（必须配置，secret 至少 32 字符）
JWT_SECRET=your-256-bit-secret-key-for-jwt-signing     # 必须配置（>=32字符）
JWT_EXPIRATION=86400000

# AstrBot
ASTRBOT_API_URL=http://localhost:6185
ASTRBOT_TOKEN=your_astrbot_token                       # 必须配置
ASTRBOT_DATA_PATH=./Astrbot/data

# NapCat
NAPCAT_API_URL=http://localhost:6100
NAPCAT_ONEBOT_API_URL=http://localhost:6100
NAPCAT_WEBUI_URL=http://127.0.0.1:6099
NAPCAT_TOKEN=your_napcat_token                         # 必须配置
NAPCAT_WEBHOOK_TOKEN=your_webhook_token                # 必须配置
NAPCAT_SELF_QQ=your_qq_number

# GPT-SoVITS
GPT_SOVITS_API_URL=http://localhost:8000
GPT_SOVITS_TOKEN=your_gpt_sovits_token

# MinIO
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=your_minio_access_key                 # 必须配置
MINIO_SECRET_KEY=your_minio_secret_key                 # 必须配置
MINIO_BUCKET=qq-chat-files

# FFmpeg
FFMPEG_PATH=ffmpeg

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=your_rabbitmq_password               # 必须配置
RABBITMQ_VHOST=/

# CORS（前端开发服务器地址，多个用逗号分隔）
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 管理员初始密码（首次启动时创建 admin 账号的密码，不设置则使用默认值）
ADMIN_INIT_PASSWORD=your_admin_password