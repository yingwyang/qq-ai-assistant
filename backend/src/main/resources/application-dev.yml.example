# 开发环境配置模板
# 复制本文件为 application-dev.yml 并填入真实配置后使用
# 命令: cp application-dev.yml.example application-dev.yml

spring:
  datasource:
    url: jdbc:mysql://localhost:3306/qq_chat?useSSL=false&serverTimezone=Asia/Shanghai&characterEncoding=UTF-8&allowPublicKeyRetrieval=true
    username: root
    password: your_password_here
    driver-class-name: com.mysql.cj.jdbc.Driver
  jpa:
    hibernate:
      ddl-auto: update
    show-sql: false
    properties:
      hibernate:
        dialect: org.hibernate.dialect.MySQLDialect
        format_sql: true
        jdbc:
          batch_size: 50
        order_inserts: true
        order_updates: true
  flyway:
    enabled: false

jwt:
  secret: ***REMOVED***

napcat:
  token: dev-token-napcat
  webhook-token: dev-webhook-token-for-napcat

minio:
  access-key: admin
  secret-key: your_minio_password_here
